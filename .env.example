# Public Google client ID for the browser
VITE_GOOGLE_CLIENT_ID=
# Same Google client ID for server-side token verification
GOOGLE_CLIENT_ID=
SUPABASE_URL=
# Server secret only; never use a VITE_ prefix
SUPABASE_SECRET_KEY=
SUPABASE_OWNER_COLUMN=user_id
PORT=3000

# Optional independent signing secret (at least 32 characters). Defaults to a derived server-secret key.
SESSION_SECRET=
